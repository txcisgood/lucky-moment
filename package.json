{
  "name": "lucky-moment",
  "productName": "幸运时刻",
  "version": "1.2.0",
  "private": true,
  "description": "本地离线抽奖应用，支持 Windows 与 macOS",
  "author": "Lucky Moment",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "start": "electron .",
    "pack:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.luckymoment.desktop",
    "productName": "幸运时刻",
    "artifactName": "LuckyMoment-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "幸运时刻",
      "window": {
        "width": 540,
        "height": 360
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "LuckyMoment-${version}-Windows-${arch}.exe"
    }
  }
}
